<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.liu.file.mapper.MindDocumentMapper">

    <select id="selectDocFileKey" resultType="java.lang.String">
        select file_key from mind_document where id = #{docId} and created_by_user_id = #{userId}
    </select>
</mapper>
